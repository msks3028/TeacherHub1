server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # The frontend calls a relative "/api" (see src/services/api.js) and
    # relies on the auth cookie being same-origin, so in production this
    # nginx (or whatever reverse proxy sits in front) must forward API and
    # uploaded-file requests to the backend container/service.
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Large video uploads can take a while on a slow connection.
        proxy_read_timeout 300s;
        client_max_body_size 600m;
    }

    location /uploads/ {
        proxy_pass ${BACKEND_URL}/uploads/;
        proxy_set_header Host $host;
    }

    # React Router (client-side routing) — always fall back to index.html
    # for unknown paths instead of nginx's default 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|webp|svg|ico)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }
}
